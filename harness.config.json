{
  "schemaVersion": 1,
  "defaultModel": "inherit",
  "defaultDelegation": "automatic",
  "maxCheckSeconds": 300,
  "maxEventsPerSession": 5000,
  "retentionDays": 30,
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.credentials.json)"
    ],
    "ask": [
      "Agent",
      "Task",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  },
  "storage": {
    "writeRoots": {
      "memory": [],
      "temporary": []
    }
  }
}
