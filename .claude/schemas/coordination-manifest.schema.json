{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eva.local/schemas/coordination-manifest.schema.json",
  "title": "Coordination Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "mode", "objective", "status", "stages"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["relay", "team"] },
    "objective": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "active", "blocked", "complete", "cancelled"] },
    "maxConcurrentWorkers": { "type": "integer", "minimum": 1, "maximum": 4 },
    "maxCorrectionRounds": { "type": "integer", "minimum": 0, "maximum": 2 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "model", "approvalId", "dependsOn", "status", "writablePaths"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "model": { "enum": ["haiku", "sonnet", "opus"] },
          "approvalId": { "type": "string", "minLength": 1 },
          "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "status": { "enum": ["proposed", "approved", "running", "blocked", "failed", "complete"] },
          "writablePaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "handoffPath": { "type": "string" }
        }
      }
    }
  }
}
