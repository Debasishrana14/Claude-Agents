{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eva.local/schemas/stage-handoff.schema.json",
  "title": "Stage Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "stage", "status", "producer", "scope", "changedFiles", "contractsProduced", "decisions", "evidence", "requestsForNextStage", "verification", "unknowns", "risks"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workId": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "status": { "enum": ["complete", "blocked", "failed"] },
    "producer": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "changedFiles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "contractsProduced": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "consumer", "invariants"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "consumer": { "type": "string", "minLength": 1 },
          "units": { "type": ["string", "null"] },
          "coordinateSpace": { "type": ["string", "null"] },
          "identity": { "type": ["string", "null"] },
          "invariants": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
        }
      }
    },
    "contractsConsumed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "claim"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requestsForNextStage": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } }
  }
}
